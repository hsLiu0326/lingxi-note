# ===========================================
# 小红书爆款文案生成器 — 环境变量配置
# 复制此文件为 .env 并填写配置
# ===========================================

# Database
DATABASE_URL=sqlite:///./xhs.db

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI API (DeepSeek)
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
# 使用 OpenAI 示例:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Stripe (optional - for payment)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
FRONTEND_URL=http://localhost:3000

# App Limits
DAILY_FREE_LIMIT=3
PREMIUM_DAILY_LIMIT=999

# Redis (required for phone verification codes)
REDIS_URL=redis://localhost:6379/0

# Aliyun SMS / PNVS (required for real phone verification codes)
# sms_enabled=true 时使用阿里云 PNVS 发送真实验证码
# sms_enabled=false 时使用固定码 000000（开发模式）
SMS_ENABLED=false
SMS_ACCESS_KEY=LTAI5t...
SMS_SECRET_KEY=...
# PNVS 个人开发者不需要自定义签名和模板，留空即可
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
